{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chequeo de alcance en dos semestres",
  "description": "Una evaluación por idea del lote. Solo inviable elimina la idea.",
  "type": "object",
  "required": ["evaluaciones"],
  "properties": {
    "evaluaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "veredicto", "horas_estimadas", "motivo"],
        "properties": {
          "id": {"type": "string"},
          "veredicto": {"enum": ["viable", "viable_con_recorte", "inviable"]},
          "horas_estimadas": {"type": "number", "minimum": 0},
          "motivo": {"type": "string", "minLength": 10, "maxLength": 800},
          "recorte_sugerido": {"type": "string", "maxLength": 800},
          "dependencias_externas": {"type": "array", "items": {"type": "string", "maxLength": 200}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
