{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idea de tesis (formato fijo de una página)",
  "description": "Lo que escriben los generadores y los defensores. Python agrega id y guarda la meta (estrategia, generador) aparte, donde el juez no la ve. local_id solo lo usan los generadores.",
  "type": "object",
  "required": ["titulo", "problema", "usuario", "solucion", "mvp", "stack", "costo_infra", "competidores", "monetizacion", "riesgos", "supuestos", "evidencias"],
  "properties": {
    "local_id": {"type": "string", "maxLength": 20},
    "id": {"type": "string"},
    "titulo": {"type": "string", "minLength": 5, "maxLength": 120},
    "problema": {"type": "string", "minLength": 40, "maxLength": 1000},
    "usuario": {"type": "string", "minLength": 10, "maxLength": 500},
    "solucion": {"type": "string", "minLength": 40, "maxLength": 1000},
    "mvp": {
      "type": "object",
      "required": ["semestre_1", "semestre_2"],
      "properties": {
        "semestre_1": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
        "semestre_2": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 3, "maxLength": 300}}
      },
      "additionalProperties": false
    },
    "stack": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "costo_infra": {
      "type": "object",
      "required": ["total_anual_usd", "items"],
      "properties": {
        "total_anual_usd": {"type": "number", "minimum": 0},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["concepto", "usd_anual", "supuesto", "fuente_precio_url"],
            "properties": {
              "concepto": {"type": "string", "minLength": 2, "maxLength": 120},
              "usd_anual": {"type": "number", "minimum": 0},
              "supuesto": {"type": "string", "minLength": 5, "maxLength": 400},
              "fuente_precio_url": {"type": "string", "format": "uri", "maxLength": 1000}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "competidores": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["nombre", "evidencia_ids", "hueco"],
        "properties": {
          "nombre": {"type": "string", "minLength": 1, "maxLength": 120},
          "evidencia_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "hueco": {"type": "string", "minLength": 5, "maxLength": 400}
        },
        "additionalProperties": false
      }
    },
    "monetizacion": {"type": "string", "minLength": 20, "maxLength": 800},
    "riesgos": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 5, "maxLength": 300}},
    "supuestos": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 300}},
    "evidencias": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
